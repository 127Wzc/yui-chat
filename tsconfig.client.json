{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": false,
    "noEmitOnError": true,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "verbatimModuleSyntax": true,
    "forceConsistentCasingInFileNames": true,
    "lib": ["ES2022", "DOM"],
    "rootDir": "web/client",
    "outDir": "output/runtime/web/client",
    "sourceMap": true,
    "declaration": false
  },
  "include": ["web/client/**/*.ts"],
  "exclude": ["node_modules", "output", "web/client/vendor"]
}
